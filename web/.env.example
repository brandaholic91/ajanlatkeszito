# A demóoldal beállításai. Helyi fejlesztéshez (npm run dev) másold le .env.local néven.
# Az értékek a docker-compose.yml helyi, a gépre kivezetett portjaira mutatnak; valódi kulcs nincs köztük.
# A compose-on belül futó web szolgáltatás ugyanezeket a docker-compose.yml-ből kapja, a szolgáltatások nevével.

# Postgres: az állapot, a lépésnapló és az ajánlatok innen jönnek
DATABASE_URL=postgresql://ajanlat:ajanlat-dev@127.0.0.1:5544/ajanlat

# n8n: ide megy tovább az új kérés és a jóváhagyás (webhook)
N8N_BASE_URL=http://127.0.0.1:5679

# Objektumtároló (RustFS, S3 API): innen jön a tárolt PDF
S3_ENDPOINT=http://127.0.0.1:9100
S3_ACCESS_KEY=ajanlat-dev
S3_SECRET_KEY=ajanlat-dev-secret
S3_BUCKET=ajanlat-demo

# Ennyi új kérést enged naponta (a nyelvi modell költségét védi). Ha nincs megadva: 50.
DAILY_REQUEST_LIMIT=50
