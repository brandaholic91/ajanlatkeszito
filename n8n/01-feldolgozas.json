    {
      "id": "81a24305-f4ba-5630-b9a1-7b59a01186f8",
      "name": "Beállítások",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9e660731-0f8b-54ad-b5d4-f59d645b0b16",
              "name": "llm_url",
              "value": "https://opencode.ai/zen/go/v1/chat/completions",
              "type": "string"
            },
            {
              "id": "c6d969c7-fe1f-5dc1-82b8-993520171f2c",
              "name": "llm_model",
              "value": "deepseek-v4.1-flash",
              "type": "string"
            },
            {
              "id": "324cc318-e127-5ee5-a047-f51cedb939a8",
              "name": "prompt",
              "value": "Egy üzleti telekom- és IT-szolgáltató ajánlatkérés-feldolgozója vagy.\nA feladatod: a szabad szöveges kérésből kiemelni a tételeket és a mennyiségeket. Árat SOHA ne írj, azt az adatbázis számolja.\n\nCsak az alábbi árlista azonosítóit (sku) használhatod:\n[[CATALOG]]\n\nSzabályok:\n- Ha a kérés \"ebből N\" formában részhalmazt ad meg, vond le a főtételből. Példa: \"40 mobil, ebből 10 korlátlan\" = 30 db MOB-PLUS és 10 db MOB-MAX.\n- Ha egy fejenkénti tételnél (egység: fő) nincs mennyiség, a kérésben szereplő létszámot használd. Ha létszám sincs, a qty legyen null.\n- Telephelyenkénti tételnél (egység: telephely) a mennyiség 1, ha a kérés nem ír többet.\n- Ha egy kért dolog nincs az árlistán, ne erőltesd rá egy hasonló tételre: tedd az unknown listába.\n- term_months: 12 vagy 24, ha a kérés megadja a hűségidőt (1 év = 12, 2 év = 24), különben null.\n- deadline: YYYY-MM-DD, ha a kérés konkrét határidőt ad, különben null.\n- headcount: a létszám, ha szerepel, különben null.\n\nCsak egyetlen JSON-objektummal válaszolj, magyarázat nélkül, ebben a formában:\n{\"items\": [{\"sku\": \"MOB-PLUS\", \"qty\": 30, \"source\": \"a kérés idevágó részlete\"}], \"unknown\": [{\"text\": \"amit nem találtál az árlistán\"}], \"term_months\": null, \"deadline\": null, \"headcount\": null}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "A modell, a végpont és a prompt itt cserélhető, egy helyen."
    },
    {
      "id": "6d380fd7-edc0-5f50-b599-1fbf52391fc8",
      "name": "Kérés mentése",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH r AS (\n  INSERT INTO requests (email, raw_text, public_id)\n  VALUES ($1, $2, COALESCE($3::uuid, gen_random_uuid()))\n  RETURNING id, public_id\n), e AS (\n  INSERT INTO request_events (request_id, step) SELECT id, 'received' FROM r\n)\nSELECT id AS request_id, public_id FROM r;",
        "options": {
          "queryReplacement": "={{ [ $('Webhook').item.json.body.email, $('Webhook').item.json.body.text, $('Webhook').item.json.body.public_id ?? null ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ajanlatDbCred0001",
          "name": "Ajánlat DB"
        }
      }
    },
    {
      "id": "3950cd28-f1c1-54b6-82d0-d156f3ca3560",
      "name": "Árlista lekérése",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT string_agg(sku || ' | ' || name || ' | egység: ' || unit || ' | ' || hint, E'\\n' ORDER BY category, sku) AS catalog FROM products;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "ajanlatDbCred0001",
          "name": "Ajánlat DB"
        }
      }
    },
    {
      "id": "79fe8f5b-e9f0-5688-ba70-b31631863107",
      "name": "Modell: tételek kiolvasása",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Beállítások').item.json.llm_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Beállítások').item.json.llm_model,\n  temperature: 0,\n  max_tokens: 800,\n  thinking: { type: 'disabled' },\n  messages: [\n    { role: 'system', content: $('Beállítások').item.json.prompt.replace('[[CATALOG]]', $json.catalog) },\n    { role: 'user', content: $('Webhook').item.json.body.text }\n  ]\n}) }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-opencode-session",
              "value": "=ajanlat-{{ $('Kérés mentése').item.json.request_id }}"
            },
            {
              "name": "User-Agent",
              "value": "ajanlatkeszito-demo/0.1"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ajanlatLlmCred001",
          "name": "LLM kulcs"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Az x-opencode-session fejlécet az opencode Go kéri (enélkül 400-at ad). Más szolgáltató figyelmen kívül hagyja."
    },
    {
      "id": "603a75e6-323c-512d-9d77-536d8470015c",
      "name": "Válasz értelmezése",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// A modell válasza szöveg. Ebből JSON-objektumot csinálunk.\n// Ha a modell ```json ... ``` keretbe tette, a keretet levágjuk.\nconst text = $json.choices?.[0]?.message?.content ?? '';\nconst cleaned = text.replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, '').trim();\n\nlet extracted;\ntry {\n  extracted = JSON.parse(cleaned);\n} catch (error) {\n  // Értelmezhetetlen válasz: nem találgatunk, az ellenőrzés visszakérdezésre viszi.\n  extracted = { items: [], unknown: [{ text: 'a kérést nem sikerült értelmezni' }] };\n}\n\nreturn {\n  json: {\n    request_id: $('Kérés mentése').item.json.request_id,\n    extracted,\n  },\n};"
      }
    },
    {
      "id": "08205aaa-818e-543b-b0cf-282bd12b3e3b",
      "name": "Ellenőrzés és árazás",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT process_request($1::bigint, $2::jsonb) AS result;",
        "options": {
          "queryReplacement": "={{ [ $json.request_id, JSON.stringify($json.extracted) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ajanlatDbCred0001",
