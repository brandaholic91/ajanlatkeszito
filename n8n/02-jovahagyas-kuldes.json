    {
      "id": "3076ab62-5ddf-4642-a067-976b4c26e0d4",
      "name": "PDF készítése",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Beállítások').item.json.pdf_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  customer_email: $json.result.customer_email,\n  request_text: $json.result.request_text,\n  quotes: $json.result.quotes\n}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "a87177e2-d7bb-4d28-bb15-a270858d21d4",
      "name": "PDF szöveggé",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "binaryToPropery",
        "binaryPropertyName": "data",
        "destinationKey": "data",
        "options": {
          "keepSource": "both"
        }
      },
      "notes": "A PDF bájtjaiból base64 szöveg lesz, mert a levélküldő JSON-ban így várja a csatolmányt. A fájl maga is megmarad, mert a következő csomópont azt tölti fel."
    },
    {
      "id": "191a458b-3895-4166-9f34-4c475ae780f9",
      "name": "PDF tárolása",
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "bucketName": "={{ $('Beállítások').item.json.pdf_bucket }}",
        "fileName": "={{ $('Jóváhagyás').item.json.result.quotes[0].number + '.pdf' }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {},
        "tagsUi": {}
      },
      "credentials": {
        "s3": {
          "id": "ajanlatS3Cred0001",
          "name": "PDF tároló"
        }
      },
      "notes": "A kiküldött PDF az objektumtárolóba kerül, az ajánlat sorszámával. A letöltés később ezt a fájlt adja vissza."
    },
    {
      "id": "4af7ca8a-5b3b-4597-99fd-9619712ad05e",
