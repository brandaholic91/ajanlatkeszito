        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  from: $('Beállítások').item.json.mail_from,\n  to: [ $('Jóváhagyás').item.json.result.customer_email ],\n  subject: 'Ajánlat ' + $('Jóváhagyás').item.json.result.quotes[0].number + ' – Kéktorony Telekom (demó)',\n  html: '<p>Tisztelt Érdeklődő!</p><p>Köszönjük az ajánlatkérését. Az elkészült ajánlatot csatolva küldjük; a sorszáma <b>' + $('Jóváhagyás').item.json.result.quotes[0].number + '</b>, és <b>' + $('Jóváhagyás').item.json.result.quotes[0].valid_until + '</b>-ig érvényes.</p><p>Üdvözlettel:<br>Kéktorony Telekom</p><hr><p style=\"color:#666;font-size:12px\">Ez egy demó. A Kéktorony Telekom kitalált cég, kitalált árakkal; ez nem valós ajánlat. A levelet azért kapta, mert ezt az e-mail-címet adták meg a demóoldalon.</p>',\n  attachments: [ {\n    filename: $('Jóváhagyás').item.json.result.quotes[0].number + '.pdf',\n    content: $('PDF szöveggé').item.json.data\n  } ]\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ajanlatResendCr01",
          "name": "Resend kulcs"
        }
      }
    },
