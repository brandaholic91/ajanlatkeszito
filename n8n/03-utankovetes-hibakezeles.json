        "content": "={{ '🟠 Ajánlatkészítő: nem ment el az emlékeztető a(z) ' + $('Levelenként egy elem').item.json.number + ' ajánlathoz (kérés #' + $('Levelenként egy elem').item.json.request_id + '). Újra nem próbálom.' }}",
        "options": {}
      },
      "credentials": {
